        "enabled": true,
        "type": "linear",
        "angle": 180,
        "colors": ["#0f172a", "#1e293b"]
      }
    },
    "grid": {
      "enabled": true,
      "size": 20,
      "snap": true
    }
  },
  "items": [
    {
      "_comment": "标题栏",
      "type": "text",
      "name": "title_main",
      "x": 50,
      "y": 30,
      "width": 600,
      "height": 60,
      "property": {
        "text": "🏭 智能生产线监控系统",
        "fontSize": 36,
        "fontFamily": "Arial, sans-serif",
        "color": "#f8fafc",
        "fontWeight": "bold",
        "align": "left"
      }
    },
    {
      "_comment": "系统时间显示",
      "type": "text",
      "name": "txt_datetime",
