{
  "_comment": "FUXA 报警规则配置",
  "projectName": "智能工厂生产线监控",
  "alarmConfig": {
    "enabled": true,
    "historyEnabled": true,
    "maxHistoryDays": 30,
    "notifications": {
      "email": {
        "enabled": false,
        "smtpServer": "",
        "port": 587,
        "username": "",
        "password": "",
        "recipients": []
      },
      "sms": {
        "enabled": false,
        "provider": "",
        "apiKey": "",
        "recipients": []
      }
    }
  },
  "alarmGroups": [
    {
      "name": "温度报警",
      "description": "温度超限报警",
      "priority": "high",
      "alarms": [
        {
          "id": "ALM_TEMP_01_HIGH",
          "name": "入口温度高",
          "description": "入口温度超过100°C",
          "tag": "${TEMP_01}",
          "condition": {
            "type": "high",
            "threshold": 100,
            "deadband": 2
          },
          "severity": "high",
          "message": "警告：入口温度过高！当前值：${TEMP_01}°C",
          "actions": [
            {
              "type": "log",
              "enabled": true
            },
            {
              "type": "script",
              "scriptId": "script_temp_alarm",
              "enabled": true
            }
          ]
        },
        {
          "id": "ALM_TEMP_01_LOW",
          "name": "入口温度低",
          "description": "入口温度低于20°C",
          "tag": "${TEMP_01}",
          "condition": {
            "type": "low",
            "threshold": 20,
            "deadband": 2
          },
          "severity": "medium",
          "message": "注意：入口温度过低！当前值：${TEMP_01}°C"
        },
        {
          "id": "ALM_TEMP_02_HIGH",
          "name": "中段温度高",
          "description": "中段温度超过140°C",
          "tag": "${TEMP_02}",
          "condition": {
            "type": "high",
            "threshold": 140,
            "deadband": 2
          },
          "severity": "high",
          "message": "警告：中段温度过高！当前值：${TEMP_02}°C"
        },
        {
          "id": "ALM_TEMP_03_HIGH",
          "name": "出口温度高",
          "description": "出口温度超过110°C",
          "tag": "${TEMP_03}",
          "condition": {
            "type": "high",
            "threshold": 110,
            "deadband": 2
          },
          "severity": "high",
          "message": "警告：出口温度过高！当前值：${TEMP_03}°C"
        }
      ]
    },
    {
      "name": "电机报警",
      "description": "电机运行异常报警",
      "priority": "medium",
      "alarms": [
        {
          "id": "ALM_MOTOR_01_FAULT",
          "name": "电机1故障",
          "description": "电机1转速异常",
          "tag": "${MOTOR_01_RPM}",
          "condition": {
            "type": "range",
            "min": 0,
            "max": 500,
            "logic": "outside"
          },
          "severity": "high",
          "message": "电机1转速异常：${MOTOR_01_RPM} RPM",
          "delay": 5000
        },
        {
          "id": "ALM_MOTOR_02_FAULT",
          "name": "电机2故障",
          "description": "电机2转速异常",
          "tag": "${MOTOR_02_RPM}",
          "condition": {
            "type": "range",
            "min": 0,
            "max": 500,
            "logic": "outside"
          },
          "severity": "high",
          "message": "电机2转速异常：${MOTOR_02_RPM} RPM",
          "delay": 5000
        }
      ]
    },
    {
      "name": "安全报警",
      "description": "安全相关报警",
      "priority": "critical",
      "alarms": [
        {
          "id": "ALM_EMERGENCY_STOP",
          "name": "紧急停止",
          "description": "急停按钮被按下",
          "tag": "${EMERGENCY_STOP}",
          "condition": {
            "type": "bool",
            "value": true
          },
          "severity": "critical",
          "message": "⚠️ 紧急停止！请检查设备安全！",
          "actions": [
            {
              "type": "log",
              "enabled": true
            },
            {
              "type": "script",
              "scriptId": "script_emergency_stop",
              "enabled": true
            }
          ]
        },
        {
          "id": "ALM_SAFETY_DOOR_OPEN",
          "name": "安全门打开",
          "description": "安全门未关闭",
          "tag": "${SAFETY_DOOR}",
          "condition": {
            "type": "bool",
            "value": false
          },
          "severity": "high",
          "message": "安全门未关闭，禁止启动设备！"
        }
      ]
    }
  ]
}
